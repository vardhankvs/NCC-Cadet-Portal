rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Cadets
    match /artifacts/{appId}/public/data/cadets/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Units/Tenant config
    match /artifacts/{appId}/public/data/units/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Visitor Tracking
    match /artifacts/{appId}/public/data/visitor_logs/{logId} {
      allow create, update: if true;
      allow read: if request.auth != null;
      allow delete: if false;
    }

    // 4. PUBLIC COLLECTIONS
    match /artifacts/{appId}/public/data/events/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /artifacts/{appId}/public/data/staff/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /artifacts/{appId}/public/data/announcements/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /artifacts/{appId}/public/data/unit_gallery/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 5. Attendance
    match /artifacts/{appId}/public/data/attendance/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid)).data.get('delegatedModules', []).hasAny(['parade', 'att_logs'])
      );
      allow update, delete: if false;
    }

    // 6. User Profiles
    match /artifacts/{appId}/public/data/users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'enrollmentId', 'delegatedModules'])) ||
        get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if false;
    }

    // 7. Transactions
    match /artifacts/{appId}/public/data/transactions/{txId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.cadetId || 
        get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow update: if request.auth != null && 
        get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if false;
    }

    // 8. All other collections (Recursive Match for sub-collections like /messages)
    match /artifacts/{appId}/public/data/{collection}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

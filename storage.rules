rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Profile Photos (admin/officer upload, anyone authenticated can read) ──
    match /artifacts/{appId}/public/profile_photos/{cadetId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Staff Photos (admin/officer upload, anyone authenticated can read) ──
    match /artifacts/{appId}/public/staff_photos/{identifier}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Training Materials ──
    match /artifacts/{appId}/public/training/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Leave Proofs (cadet uploads own proof) ──
    match /artifacts/{appId}/private/leave_proofs/{cadetId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // ── Legacy path (for backwards compat with older profilePhotos/ uploads) ──
    match /profilePhotos/{cadetId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Catch-all: deny everything else ──
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
